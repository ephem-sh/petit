{
  "name": "@ephem-sh/petit",
  "version": "0.1.2",
  "description": "Small, fast, local-first documentation",
  "license": "MIT",
  "author": "ephem-sh",
  "homepage": "https://petit.ephem.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/ephem-sh/petit"
  },
  "keywords": [
    "documentation",
    "markdown",
    "static-site",
    "docs",
    "seo"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "petit": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@resvg/resvg-js": "^2.6.2",
    "chokidar": "^5.0.0",
    "citty": "^0.2.1",
    "get-port-please": "^3.2.0",
    "gray-matter": "^4.0.3",
    "jiti": "^2.6.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-shiki": "^0.0.9",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.25.0",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
