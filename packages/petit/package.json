{
  "name": "@ephem-sh/petit",
  "version": "0.1.12",
  "description": "Small, fast, local-first documentation",
  "license": "MIT",
  "author": "ephem-sh",
  "homepage": "https://petit.ephem.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/ephem-sh/petit"
  },
  "keywords": [
    "documentation",
    "markdown",
    "static-site",
    "docs",
    "seo"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "petit": "./dist/cli/index.js"
  },
